{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"angular-bootstrap": {
			"projectType": "library",
			"root": "projects/angular-bootstrap",
			"sourceRoot": "projects/angular-bootstrap/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"options": {
						"project": "projects/angular-bootstrap/ng-package.json"
					},
					"configurations": {
						"production": {
							"tsConfig": "projects/angular-bootstrap/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/angular-bootstrap/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"tsConfig": "projects/angular-bootstrap/tsconfig.spec.json",
						"runnerConfig": ""
					}
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": [
							"projects/angular-bootstrap/**/*.ts",
							"projects/angular-bootstrap/**/*.html"
						],
						"eslintConfig": "projects/angular-bootstrap/eslint.config.mjs"
					}
				}
			}
		},
		"angular-globalite": {
			"projectType": "library",
			"root": "projects/angular-globalite",
			"sourceRoot": "projects/angular-globalite/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"options": {
						"project": "projects/angular-globalite/ng-package.json"
					},
					"configurations": {
						"production": {
							"tsConfig": "projects/angular-globalite/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/angular-globalite/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"tsConfig": "projects/angular-globalite/tsconfig.spec.json",
						"runnerConfig": ""
					}
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": [
							"projects/angular-globalite/**/*.ts",
							"projects/angular-globalite/**/*.html"
						],
						"eslintConfig": "projects/angular-globalite/eslint.config.mjs"
					}
				}
			}
		},
		"test-app": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/test-app",
			"sourceRoot": "projects/test-app/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"outputPath": "dist/test-app",
						"index": "projects/test-app/src/index.html",
						"browser": "projects/test-app/src/main.ts",
						"polyfills": ["zone.js"],
						"tsConfig": "projects/test-app/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/test-app/public"
							}
						],
						"styles": ["projects/test-app/src/styles.scss"],
						"scripts": []
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "test-app:build:production"
						},
						"development": {
							"buildTarget": "test-app:build:development"
						}
					},
					"defaultConfiguration": "development"
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"tsConfig": "projects/test-app/tsconfig.spec.json",
						"runnerConfig": ""
					}
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": [
							"projects/test-app/**/*.ts",
							"projects/test-app/**/*.html"
						],
						"eslintConfig": "projects/test-app/eslint.config.mjs"
					}
				}
			}
		},
		"angular-forms": {
			"projectType": "library",
			"root": "projects/angular-forms",
			"sourceRoot": "projects/angular-forms/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"options": {
						"project": "projects/angular-forms/ng-package.json"
					},
					"configurations": {
						"production": {
							"tsConfig": "projects/angular-forms/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/angular-forms/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"tsConfig": "projects/angular-forms/tsconfig.spec.json",
						"runnerConfig": ""
					}
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": [
							"projects/angular-forms/**/*.ts",
							"projects/angular-forms/**/*.html"
						],
						"eslintConfig": "projects/angular-forms/eslint.config.mjs"
					}
				}
			}
		}
  },
  "cli": {
    "analytics": false
  }
}
